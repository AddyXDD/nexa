# Google integration — placeholder values only.
#
# One OAuth client backs two independent flows: "Continue with Google"
# sign-in (README §8.1) and the Calendar connection (§14). Both callback URIs
# must be registered on that client — see README §14.4 before setting these.
#
# These are Convex deployment environment variables, never Vite/browser ones.
# Set them with `bunx convex env set NAME value` (or the Convex dashboard),
# and never commit real secrets. README §14.5 explains each one.
#
# `.env.example` itself is platform-managed and cannot be edited from the
# builder, so this file is the copy-pasteable template.

# Used by sign-in AND the calendar integration.
# Sign-in needs CONVEX_SITE_URL (already set by Convex), but not SITE_URL:
# post-sign-in destinations are pinned to https://nexameet.in in
# src/convex/site.ts, so a deployment-specific SITE_URL is never consulted.
GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me-with-the-client-secret
CALENDAR_TOKEN_KEY=replace-me-with-32-random-bytes   # openssl rand -base64 32
CALENDAR_REDIRECT_URI=                               # optional; defaults to <CONVEX_SITE_URL>/oauth/calendar/callback
NEXA_SITE_URL=                                       # optional; defaults to https://nexameet.in

# Meeting invitation email (used by the same scheduling flow)
RESEND_API_KEY=re_replace_me
RESEND_EMAIL_FROM=                                   # e.g. Nexa Meet <meetings@nexameet.in>
